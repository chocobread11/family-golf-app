generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id        String   @id @default(uuid())
  name      String   @unique
  pars      Int[]
  createdAt DateTime @default(now())
  games     Game[]
}

model GroupTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  players   String[]
  createdAt DateTime @default(now())
}

model Game {
  id         String   @id @default(uuid())
  date       DateTime @default(now())
  courseId   String
  totalHoles Int
  startingLoop String @default("Front")
  coursePars Int[] @default([])
  imageUrl   String?
  players    String[]
  scoresJson Json
  createdAt  DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id])
}

// Keep failed storage deletions retryable after a match is changed or removed.
model ImageCleanup {
  url       String   @id
  createdAt DateTime @default(now())
}
